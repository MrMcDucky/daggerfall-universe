{
  "name": "daggerfall-js-app",
  "productName": "DF World",
  "private": true,
  "version": "0.1.0",
  "description": "DF World - the downloadable desktop shell. Loads the same dist/ the website deploys; adds ARENA2-from-disk and file-backed saves.",
  "author": "Lattymoy",
  "homepage": "https://mrmcducky.github.io/daggerfall-universe/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrMcDucky/daggerfall-universe.git"
  },
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "predist": "cd .. && npm run build && node scripts/desktopRelease.mjs stage",
    "dist": "electron-builder",
    "postdist": "cd .. && node scripts/desktopRelease.mjs unstage"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.mrmcducky.dfworld",
    "productName": "DF World",
    "icon": "../public/icons/icon-512.png",
    "afterPack": "./afterPack.cjs",
    "artifactName": "DF-World-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MrMcDucky",
        "repo": "daggerfall-universe"
      }
    ],
    "files": [
      "main.cjs",
      "preload.cjs",
      "launcherPreload.cjs",
      "launcher/**",
      "lib/**",
      "private/**",
      "game-seed.json",
      "dist/**",
      "!**/node_modules/@img/**",
      "!**/node_modules/sharp/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "DF-World-win-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "DF-World-win-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "extendInfo": {
        "NSDownloadsFolderUsageDescription": "DF World looks here for the Daggerfall game files you unpacked, only when it found none elsewhere. Nothing is copied or uploaded.",
        "NSDesktopFolderUsageDescription": "DF World looks here for the Daggerfall game files you unpacked, only when it found none elsewhere. Nothing is copied or uploaded.",
        "NSDocumentsFolderUsageDescription": "DF World looks here for the Daggerfall game files you unpacked, only when it found none elsewhere. Nothing is copied or uploaded."
      }
    },
    "asarUnpack": [
      "**/node_modules/workerd/**",
      "**/node_modules/@cloudflare/workerd-*/**"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "miniflare": "4.20260730.0"
  }
}
